# 복사해서 .env로 쓰거나 셸 환경변수로 지정한다. 실제 .env는 커밋하지 않는다.
DB_URL=jdbc:mysql://localhost:3306/wakesong?characterEncoding=UTF-8
DB_USERNAME=wakesong
DB_PASSWORD=change-me
# update(기본) | validate | none
DDL_AUTO=update
# 쉼표로 구분한 FE Origin 목록. '*'는 쓰지 않는다.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
